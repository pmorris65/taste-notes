{
  "expo": {
    "name": "Taste Notes",
    "slug": "taste-notes",
    "scheme": "tastenotes",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pmorris65.tastenotes",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pmorris65.tastenotes",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9A5424"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Taste Notes uses your location in the background to remind you of your notes when you arrive at a saved place.",
          "locationAlwaysPermission": "Taste Notes uses your location in the background to remind you of your notes when you arrive at a saved place.",
          "locationWhenInUsePermission": "Taste Notes uses your location to sort places by distance and to save where a place is.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9A5424"
        }
      ]
    ]
  }
}
